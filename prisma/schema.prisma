generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String   @default("")
  description      String   @default("")
  role             String   @default("")
  technologies     String[] @default([])
  coverImage       String?
  coverAlt         String   @default("")
  gallery          Json     @default("[]")
  liveUrl          String?
  githubUrl        String?
  featured         Boolean  @default(false)
  published        Boolean  @default(false)
  order            Int      @default(0)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?
  noIndex        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  excerpt    String   @default("")
  content    String   @default("")
  coverImage String?
  coverAlt   String   @default("")
  category   String   @default("")
  tags       String[] @default([])
  author     String   @default("Fuad Hasan Emon")
  featured   Boolean  @default(false)
  published  Boolean  @default(false)
  order      Int      @default(0)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  noIndex        Boolean @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stats PostStats?

  @@index([published, publishedAt])
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id      String        @id @default(cuid())
  name    String
  email   String
  needs   String
  budget  String        @default("")
  message String
  status  MessageStatus @default(NEW)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model Subscriber {
  id     String           @id @default(cuid())
  email  String           @unique
  status SubscriberStatus @default(ACTIVE)
  // Slug of the post the reader signed up from; empty if unknown.
  source String           @default("")
  // Goes in every future newsletter's unsubscribe link. Generated now so
  // existing rows never need a backfill once sending starts.
  unsubscribeToken String @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Reader counters live apart from Post on purpose: Post.updatedAt is
// @updatedAt and drives the "Updated" label, sitemap lastmod and JSON-LD
// dateModified, so bumping a counter on Post would mark it edited.
model PostStats {
  postId String @id
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  views  Int    @default(0)
  likes  Int    @default(0)
}

// The managed list behind the post editor's category picker. Post.category
// still stores the name as a plain string, so posts need no migration;
// renaming a category rewrites that string on its posts.
model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
