# --- Database (Neon free tier: https://neon.tech) ---------------------------
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by prisma migrate / db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Admin auth -------------------------------------------------------------
# 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# IMPORTANT: Next.js runs .env through dotenv-expand, which eats the `$`
# segments of a bcrypt hash. Every $ MUST be escaped as \$ and the value MUST
# be double-quoted, or login fails with a misleading "Incorrect password".
# `npm run hash:password -- "your-password"` prints the correctly escaped line.
# Example shape (not a real hash):
#   ADMIN_PASSWORD_HASH="\$2b\$12\$abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRS"
# On Vercel, paste the UNESCAPED hash - the dashboard stores values literally.
ADMIN_PASSWORD_HASH=""

# --- Images (Cloudinary free tier) -----------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://fuadhasanemon.vercel.app"
